# ── Load cloud models from ~/.llmcw/config.json ────────────────────
# Populates: CLOUD_MODEL_IDS, CLOUD_DISPLAY, CLOUD_PROV_IDS,
#            CLOUD_PROV_TYPES, CLOUD_API_KEYS, CLOUD_BASE_URLS
load_cloud_config() {
  local backend="$1"
  CLOUD_MODEL_IDS=()
  CLOUD_DISPLAY=()
  CLOUD_PROV_IDS=()
  CLOUD_PROV_TYPES=()
  CLOUD_API_KEYS=()
  CLOUD_BASE_URLS=()

  [[ ! -f "$LLMCW_CONFIG" ]] && return 0

  local tmppy
  tmppy="$(mktemp /tmp/llmcw-cfg.XXXXXX.py)"
  cat > "$tmppy" << 'PYEOF'
import json, sys

config_file, backend = sys.argv[1], sys.argv[2]

try:
    with open(config_file) as f:
        cfg = json.load(f)
except Exception as e:
    sys.stderr.write(f'llmcw: config error: {e}\n')
    sys.exit(0)

providers = cfg.get('providers', {})
models_raw = cfg.get('models', {}).get(backend, [])
models = models_raw.get('list', []) if isinstance(models_raw, dict) else models_raw

def sq(s):
    return "'" + str(s).replace("'", "'\\''") + "'"

arrays = [
    ('CLOUD_MODEL_IDS',  [m.get('model', '')                                                      for m in models]),
    ('CLOUD_PROV_IDS',   [m.get('provider', '')                                                   for m in models]),
    ('CLOUD_PROV_TYPES', [providers.get(m.get('provider',''), {}).get('type', 'openai_compatible') for m in models]),
    ('CLOUD_API_KEYS',   [providers.get(m.get('provider',''), {}).get('api_key', '')               for m in models]),
    ('CLOUD_BASE_URLS',  [providers.get(m.get('provider',''), {}).get('base_url', '')              for m in models]),
    ('CLOUD_DISPLAY',    [
        m.get('display', m.get('model', '')) + ' ['
        + providers.get(m.get('provider',''), {}).get('name', m.get('provider','')) + ']'
        for m in models
    ]),
]

for name, values in arrays:
    print(f'{name}=(')
    for v in values:
        print(f'  {sq(v)}')
    print(')')
PYEOF
  eval "$(python3 "$tmppy" "$LLMCW_CONFIG" "$backend")"
  rm -f "$tmppy"
}

# ── Quit Claude Desktop and wait for it to exit ────────────────────
# Must happen BEFORE writing config so Claude's exit doesn't overwrite it.
quit_if_running() {
  if pgrep -x "Claude" >/dev/null 2>&1; then
    echo "Quitting Claude Desktop..."
    osascript -e 'quit app "Claude"' 2>/dev/null || killall "Claude" 2>/dev/null || true
    local elapsed=0
    while pgrep -x "Claude" >/dev/null 2>&1 && (( elapsed < 40 )); do
      sleep 0.5
      (( elapsed++ )) || true
    done
  fi
}

# ── Launch Cowork and wait for session to end ──────────────────────
launch_cowork() {
  open -a "Claude"
  echo ""
  echo "Claude Cowork is open. Press Enter here when your session is done"
  echo "to restore the original provider settings and clean up."
  read -r _
}

# ── Print key fields from the written config (diagnostic) ──────────
show_config() {
  python3 - "$CLAUDE_CONFIG" << 'PYEOF'
import json, sys
try:
    cfg = json.load(open(sys.argv[1]))
    ec = cfg.get('enterpriseConfig', {})
    dm = cfg.get('deploymentMode', '(not set)')
    print(f"  deploymentMode:            {dm}")
    print(f"  inferenceProvider:         {ec.get('inferenceProvider', '(not set)')}")
    print(f"  inferenceGatewayBaseUrl:   {ec.get('inferenceGatewayBaseUrl', '(not set)')}")
    print(f"  inferenceGatewayAuthScheme:{ec.get('inferenceGatewayAuthScheme', '(not set)')}")
    print(f"  inferenceModels:           {ec.get('inferenceModels', '(not set)')}")
except Exception as e:
    print(f"  ERROR reading config: {e}")
PYEOF
}

# ── Main ───────────────────────────────────────────────────────────
main() {
  local BACKEND="${1:-claude}"
  case "$BACKEND" in
    claude) ;;
    *) echo "Usage: llmcw [claude]" >&2; exit 1 ;;
  esac

  ensure_config
  local -a CLOUD_MODEL_IDS CLOUD_DISPLAY CLOUD_PROV_IDS CLOUD_PROV_TYPES CLOUD_API_KEYS CLOUD_BASE_URLS
  load_cloud_config "$BACKEND"

  echo "=============================================="
  echo "  llmcw — LLM Cowork Launcher (${BACKEND})"
  echo "=============================================="
  echo ""

  PROXY_PID=""
  PROXY_SCRIPT=""
  PROXY_PORT=""
  LITELLM_LOG_FILE=""
  LOADED_LOCAL_MODEL=""
  LMS_DAEMON_STARTED=""
  PREF_BACKUP_FILE="$(save_prefs)"
  trap cleanup EXIT

  # ── Start LM Studio daemon if not already running ──────────────
  if is_local_url && command -v lms >/dev/null 2>&1; then
    if ! curl -sf "$LM_STUDIO_MODELS_API" >/dev/null 2>&1; then
      echo "Starting LM Studio daemon..."
      lms daemon up 2>/dev/null || true
      LMS_DAEMON_STARTED=1
      local elapsed=0
      while (( elapsed < 20 )) && ! curl -sf "$LM_STUDIO_MODELS_API" >/dev/null 2>&1; do
        sleep 0.5
        (( elapsed++ )) || true
      done
    fi
  fi

  # ── Fetch local models ─────────────────────────────────────────
  local local_json
  local_json="$(fetch_local_models)" || true

  local -a local_keys=() local_names=() local_archs=()
  local -a local_quants=() local_sizes=() local_contexts=()
  local -a local_loaded=() local_variants=()

  if [[ -n "$local_json" ]]; then
    eval "$(python3 -c "
import json, sys

models = json.loads(sys.argv[1]).get('models', [])
llms = [m for m in models if m.get('type') == 'llm']

def sq(s):
    return \"'\" + str(s).replace(\"'\", \"'\\\\''\" ) + \"'\"

print('local_keys=(')
for m in llms:
    print(f'    {sq(m[\"key\"])}')
print(')')

print('local_names=(')
for m in llms:
    print(f'    {sq(m.get(\"display_name\", m[\"key\"]))}')
print(')')

print('local_archs=(')
for m in llms:
    print(f'    {sq(m.get(\"architecture\", \"?\"))}')
print(')')

print('local_quants=(')
for m in llms:
    q = m.get('quantization', {})
    print(f'    {sq(str(q.get(\"name\", \"?\")) + \" (\" + str(q.get(\"bits_per_weight\", \"?\")) + \"bit)\")}')
print(')')

print('local_sizes=(')
for m in llms:
    print(f'    {sq(m.get(\"size_bytes\", 0))}')
print(')')

print('local_contexts=(')
for m in llms:
    print(f'    {sq(m.get(\"max_context_length\", 0))}')
print(')')

print('local_loaded=(')
for m in llms:
    inst = m.get('loaded_instances', [])
    print(f'    {sq(len(inst))}')
print(')')

print('local_variants=(')
for m in llms:
    variants = m.get('variants', [])
    sel = m.get('selected_variant', '')
    if sel:
        print(f'    {sq(sel)}')
    elif variants:
        print(f'    {sq(variants[0])}')
    else:
        print(\"    ''\")
print(')')
" "$local_json")"
  fi

  local num_local=${#local_keys[@]}
  local total=$(( num_local + ${#CLOUD_MODEL_IDS[@]} ))

  # ── Display menu ───────────────────────────────────────────────
  printf "  %-3s  %s\n" "0" "Default model (no override)"
  echo ""

  if (( num_local > 0 )); then
    echo "Local LLMs (from LM Studio):"
    echo "----------------------------------------------"
    printf "  %-3s  %-28s  %-8s  %-10s  %-8s  %-8s  %s\n" \
      "#" "Name" "Arch" "Quant" "Size" "Context" "Loaded"
    printf "  %-3s  %-28s  %-8s  %-10s  %-8s  %-8s  %s\n" \
      "---" "----------------------------" "--------" "----------" "--------" "--------" "------"
    for (( i = 0; i < num_local; i++ )); do
      local loaded_marker=""
      (( ${local_loaded[$i]} > 0 )) && loaded_marker=" [LOADED]"
      printf "  %-3s  %-28s  %-8s  %-10s  %-8s  %-8s  %s\n" \
        "$((i + 1))" \
        "${local_names[$i]:-${local_keys[$i]}}" \
        "${local_archs[$i]}" \
        "${local_quants[$i]}" \
        "$(format_size ${local_sizes[$i]})" \
        "${local_contexts[$i]}" \
        "${loaded_marker}"
    done
    echo ""
  else
    echo "No local LLMs found from LM Studio."
    echo ""
  fi

  local cloud_label
  case "$BACKEND" in
    claude) cloud_label="Claude Cowork models" ;;
  esac

  echo "${cloud_label}:"
  echo "----------------------------------------------"
  if (( ${#CLOUD_MODEL_IDS[@]} > 0 )); then
    for (( i = 0; i < ${#CLOUD_MODEL_IDS[@]}; i++ )); do
      local idx=$(( num_local + i + 1 ))
      printf "  %-3s  %-40s  (%s)\n" "$idx" "${CLOUD_DISPLAY[$i]}" "${CLOUD_MODEL_IDS[$i]}"
    done
  else
    echo "  (none configured — edit ${LLMCW_CONFIG})"
  fi
  echo ""
  printf "  %-3s  %s\n" "Q/E" "Quit / Exit"
  echo ""
  echo "----------------------------------------------"

  # ── Prompt for selection ───────────────────────────────────────
  read -p "Choose a model (0-$total, Q/E to quit) [0]: " opt
  [[ -z "$opt" ]] && opt=0

  if [[ "$opt" == "q" || "$opt" == "Q" || "$opt" == "e" || "$opt" == "E" ]]; then
    echo "Goodbye."
    return 0
  fi

  if ! [[ "$opt" =~ ^[0-9]+$ ]] || (( opt < 0 )) || (( opt > total )); then
    echo "Invalid selection."
    return 1
  fi

  local model_display=""

  # Quit Claude before writing config so its exit can't overwrite our settings
  quit_if_running

  if (( opt == 0 )); then
    model_display="default (no model override)"
    clear_gateway_prefs
    echo "Using ${model_display}"

  elif (( opt <= num_local )); then
    # ── Local model via LM Studio gateway ─────────────────────────
    local idx=$(( opt - 1 ))
    local key="${local_keys[$idx]}"
    local variant="${local_variants[$idx]:-$key}"
    model_display="${local_names[$idx]:-$key} (local via LM Studio)"

    if is_local_url && command -v lms >/dev/null 2>&1; then
      local needs_unload=0
      for (( j = 0; j < num_local; j++ )); do
        (( ${local_loaded[$j]} > 0 )) && needs_unload=1 || true
      done
      if (( needs_unload )); then
        echo "Unloading current model..."
        lms unload --all 2>/dev/null || true
      fi
      echo "Loading ${local_names[$idx]:-$key}..."
      lms load "$key"
      LOADED_LOCAL_MODEL="$key"
    elif is_local_url; then
      echo "Warning: 'lms' command not found; skipping model load/unload."
    else
      echo "Note: remote LM Studio URL — skipping lms load/unload."
    fi

    # Use the base key (not the variant) as the model ID — LM Studio treats the
    # @quantization suffix as a load request, which fails when memory is tight.
    set_gateway_prefs \
      "${LM_STUDIO_URL}" \
      "lmstudio" \
      "bearer" \
      "[\"${key}\"]"

    echo "Using local model: ${model_display}"
    echo "  Gateway:   ${LM_STUDIO_URL}"
    echo "  Model:     ${key}"

  else
    # ── Cloud model from config ────────────────────────────────────
    local cidx=$(( opt - num_local - 1 ))
    local raw_model="${CLOUD_MODEL_IDS[$cidx]}"
    local ptype="${CLOUD_PROV_TYPES[$cidx]}"
    local api_key="${CLOUD_API_KEYS[$cidx]}"
    local base_url="${CLOUD_BASE_URLS[$cidx]}"
    model_display="${CLOUD_DISPLAY[$cidx]}"

    case "$BACKEND" in
      claude)
        if [[ "$ptype" == "anthropic" ]]; then
          # Use Cowork's account login — just clear gateway and specify the model
          clear_gateway_prefs "[\"${raw_model}\"]"
          echo "Using account login for: ${model_display}"
          echo "  Model:     ${raw_model}"
        else
          # Start LiteLLM proxy → it becomes the /v1/messages gateway for Cowork
          if [[ -z "$api_key" ]]; then
            echo "  Warning: API key not set — add api_key for this provider in ${LLMCW_CONFIG}"
          fi
          start_litellm_proxy "$raw_model" "$base_url" "$api_key" || return 1
          set_gateway_prefs \
            "http://127.0.0.1:${PROXY_PORT}" \
            "llmcw-proxy" \
            "bearer" \
            "[\"${raw_model}\"]"
          echo "Using cloud model: ${model_display}"
          echo "  Model:     ${raw_model}"
          echo "  Proxy:     localhost:${PROXY_PORT} → ${base_url}"
          echo "  Log:       ${LITELLM_LOG_FILE}"
        fi
        ;;
    esac
  fi

  echo ""
  echo "Provider config written to: ${CLAUDE_CONFIG}"
  show_config
  echo ""
  launch_cowork
}

main "$@"
