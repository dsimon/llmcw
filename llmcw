#!/usr/bin/env bash
#
# llmcw — Launch Claude Cowork with a selected local or cloud model.
# Usage: llmcw [claude]   (default: claude)
#
# Provider config is written to ~/Library/Application Support/Claude/claude_desktop_config.json
# (under the enterpriseConfig key) before launching Claude Desktop, and restored on exit.
#
set -euo pipefail

# ── Configuration ──────────────────────────────────────────────────
LLMCW_CONFIG="${HOME}/.llmcw/config.json"
CLAUDE_CONFIG="${HOME}/Library/Application Support/Claude-3p/claude_desktop_config.json"
INFERENCE_KEYS=(
  inferenceProvider
  inferenceGatewayBaseUrl
  inferenceGatewayApiKey
  inferenceGatewayAuthScheme
  inferenceModels
  inferenceGatewayHeaders
)
LM_STUDIO_URL="http://127.0.0.1:1234"
LM_STUDIO_MODELS_API="${LM_STUDIO_URL}/api/v1/models"

# ── Config file save/restore ────────────────────────────────────────
# Saves enterpriseConfig and deploymentMode so both can be restored verbatim.
save_prefs() {
  local backup_file
  backup_file="$(mktemp /tmp/llmcw-backup.XXXXXX.json)"
  python3 - "$CLAUDE_CONFIG" "$backup_file" << 'PYEOF'
import json, sys
config_file, backup_file = sys.argv[1], sys.argv[2]
try:
    with open(config_file) as f:
        cfg = json.load(f)
    snapshot = {
        'enterpriseConfig': cfg.get('enterpriseConfig', {}),
        'deploymentMode':   cfg.get('deploymentMode'),
    }
except Exception:
    snapshot = {'enterpriseConfig': {}, 'deploymentMode': None}
with open(backup_file, 'w') as f:
    json.dump(snapshot, f)
PYEOF
  echo "$backup_file"
}

restore_prefs() {
  local backup_file="$1"
  python3 - "$CLAUDE_CONFIG" "$backup_file" << 'PYEOF'
import json, sys
config_file, backup_file = sys.argv[1], sys.argv[2]
with open(backup_file) as f:
    snapshot = json.load(f)
ec = snapshot.get('enterpriseConfig', {})
dm = snapshot.get('deploymentMode')
try:
    with open(config_file) as f:
        cfg = json.load(f)
except Exception:
    cfg = {}
if ec:
    cfg['enterpriseConfig'] = ec
else:
    cfg.pop('enterpriseConfig', None)
if dm is not None:
    cfg['deploymentMode'] = dm
else:
    cfg.pop('deploymentMode', None)
with open(config_file, 'w') as f:
    json.dump(cfg, f, indent=2)
PYEOF
  rm -f "$backup_file"
  PREF_BACKUP_FILE=""
}

set_gateway_prefs() {
  local base_url="$1" api_key="$2" auth_scheme="${3:-bearer}" models_json="${4:-}"
  python3 - "$CLAUDE_CONFIG" "$base_url" "$api_key" "$auth_scheme" "$models_json" << 'PYEOF'
import json, sys
config_file, base_url, api_key, auth_scheme, models_json = sys.argv[1:]
try:
    with open(config_file) as f:
        cfg = json.load(f)
except Exception:
    cfg = {}
ec = cfg.get('enterpriseConfig', {})
ec['inferenceProvider'] = 'gateway'
ec['inferenceGatewayBaseUrl'] = base_url
ec['inferenceGatewayApiKey'] = api_key
ec['inferenceGatewayAuthScheme'] = auth_scheme
if models_json:
    ec['inferenceModels'] = json.loads(models_json)
cfg['enterpriseConfig'] = ec
# deploymentMode must be "3p" so the bootstrap response includes gateway account config
cfg['deploymentMode'] = '3p'
with open(config_file, 'w') as f:
    json.dump(cfg, f, indent=2)
PYEOF
}

clear_gateway_prefs() {
  local models_json="${1:-}"
  python3 - "$CLAUDE_CONFIG" "$models_json" << 'PYEOF'
import json, sys
config_file, models_json = sys.argv[1], sys.argv[2]
try:
    with open(config_file) as f:
        cfg = json.load(f)
except Exception:
    cfg = {}
ec = cfg.get('enterpriseConfig', {})
for key in ['inferenceProvider', 'inferenceGatewayBaseUrl', 'inferenceGatewayApiKey',
            'inferenceGatewayAuthScheme', 'inferenceGatewayHeaders']:
    ec.pop(key, None)
if models_json:
    ec['inferenceModels'] = json.loads(models_json)
else:
    ec.pop('inferenceModels', None)
if ec:
    cfg['enterpriseConfig'] = ec
else:
    cfg.pop('enterpriseConfig', None)
# For non-gateway (Anthropic direct), deploymentMode should not be "3p"
cfg.pop('deploymentMode', None)
with open(config_file, 'w') as f:
    json.dump(cfg, f, indent=2)
PYEOF
}

# ── Helpers ────────────────────────────────────────────────────────
cleanup() {
  if [[ -n "${PROXY_PID:-}" ]]; then
    kill "$PROXY_PID" 2>/dev/null || true
    PROXY_PID=""
  fi
  [[ -n "${PROXY_SCRIPT:-}" ]] && { rm -f "$PROXY_SCRIPT"; PROXY_SCRIPT=""; }
  [[ -n "${LITELLM_LOG_FILE:-}" ]] && { rm -f "$LITELLM_LOG_FILE"; LITELLM_LOG_FILE=""; }
  if [[ -n "${LOADED_LOCAL_MODEL:-}" ]] && command -v lms >/dev/null 2>&1; then
    echo ""
    echo "Unloading local model: ${LOADED_LOCAL_MODEL}..."
    lms unload --all 2>/dev/null || true
  fi
  if [[ -n "${LMS_DAEMON_STARTED:-}" ]] && command -v lms >/dev/null 2>&1; then
    echo ""
    echo "Stopping LM Studio daemon..."
    lms daemon down 2>/dev/null || true
  fi
  if [[ -n "${PREF_BACKUP_FILE:-}" ]]; then
    restore_prefs "$PREF_BACKUP_FILE"
    echo "[$(date '+%H:%M:%S')] Restored original Cowork preferences."
  fi
}

is_local_url() {
  [[ "${LM_STUDIO_URL}" =~ ^https?://(localhost|127\.[0-9]+\.[0-9]+\.[0-9]+)(:[0-9]+)?(/.*)?$ ]]
}

# ── Start a LiteLLM proxy (Anthropic→OpenAI translation gateway) ───
# Exposes a /v1/messages endpoint that Cowork's gateway mode can reach,
# translating requests to the upstream OpenAI-compatible provider.
# Sets PROXY_PORT on success.
start_litellm_proxy() {
  local model="$1"
  local base_url="$2"
  local api_key="$3"

  if ! command -v litellm >/dev/null 2>&1; then
    echo "" >&2
    echo "  Error: 'litellm' is required for external cloud providers." >&2
    echo "  Install: uv tool install 'litellm[proxy]'" >&2
    echo "" >&2
    return 1
  fi

  PROXY_PORT=$(python3 -c \
    "import socket; s=socket.socket(); s.bind(('',0)); print(s.getsockname()[1]); s.close()")

  PROXY_SCRIPT="$(mktemp /tmp/llmcw-litellm.XXXXXX.yaml)"
  if [[ "$base_url" == *"openrouter.ai"* ]]; then
    cat > "$PROXY_SCRIPT" << YAML
model_list:
  - model_name: "${model}"
    litellm_params:
      model: "openrouter/${model}"
      api_key: "${api_key}"

litellm_settings:
  drop_params: true
YAML
  else
    cat > "$PROXY_SCRIPT" << YAML
model_list:
  - model_name: "${model}"
    litellm_params:
      model: "openai/${model}"
      api_base: "${base_url}"
      api_key: "${api_key}"

litellm_settings:
  drop_params: true
YAML
  fi

  LITELLM_LOG_FILE="$(mktemp /tmp/llmcw-litellm.XXXXXX.log)"
  LITELLM_USE_CHAT_COMPLETIONS_URL_FOR_ANTHROPIC_MESSAGES=true \
    litellm --config "$PROXY_SCRIPT" --port "$PROXY_PORT" \
    > "$LITELLM_LOG_FILE" 2>&1 &
  PROXY_PID=$!

  local elapsed=0
  while (( elapsed < 100 )); do
    curl -sf "http://127.0.0.1:${PROXY_PORT}/health" >/dev/null 2>&1 && break
    sleep 0.2
    (( elapsed++ )) || true
  done

  if ! curl -sf "http://127.0.0.1:${PROXY_PORT}/health" >/dev/null 2>&1; then
    echo "Error: litellm proxy did not start (check ${LITELLM_LOG_FILE})" >&2
    return 1
  fi
}

# ── Fetch local models from LM Studio ──────────────────────────────
fetch_local_models() {
  local json
  json="$(curl -s "$LM_STUDIO_MODELS_API" 2>/dev/null)" || { echo ""; return 1; }
  echo "$json"
}

format_size() {
  local bytes="$1"
  if (( bytes >= 1073741824 )); then
    printf "%.1f GB" "$(echo "scale=1; $bytes / 1073741824" | bc)"
  elif (( bytes >= 1048576 )); then
    printf "%.1f MB" "$(echo "scale=1; $bytes / 1048576" | bc)"
  else
    printf "%d KB" "$(echo "scale=0; $bytes / 1024" | bc)"
  fi
}

